# ==============================================================================
# Git Ignore Rules for Word Document Splitter
# Protects personal documents, user data, output splits, environment configs,
# caches, and temporary files from being tracked or exposed in public repositories.
# ==============================================================================

# --- Microsoft Word & Office Documents (Personal / Confidential Data) ---
*.docx
*.doc
*.docm
*.dotx
*.dotm
*.rtf
*.odt

# Specific personal document & project name safeguards
*Fandaqah*
*HMS*

# Microsoft Word temporary lock files (created while files are open in Word)
~$*.docx
~$*.doc
~$*.docm
.~lock.*.docx#
.~lock.*.doc#

# --- PDF Documents & Exports ---
*.pdf

# --- Split Outputs & Working Directories ---
# Ignore any folder ending in _split or _splits (the default output folders)
*_split/
*_splits/
*_split
output/
outputs/
splits/
split_output/
test_temp/
temp/
tmp/

# --- Temporary & Backup Files ---
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.pruned.tmp

# --- Python Environment & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Testing & Code Quality Caches ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# --- Environment Variables, Secrets & Credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets.json
credentials.json
config.local.json
config.local.yaml
config.local.yml

# --- IDE & Editor Specific Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Log Files ---
*.log
logs/

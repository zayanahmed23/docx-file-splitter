# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to '.env' if you wish to customize runtime defaults.
# Note: The application runs with sensible defaults out-of-the-box with NO
# required environment variables or API keys.
# ==============================================================================

# Default splitting method ('memory', 'words', 'blocks', 'headings')
DEFAULT_SPLIT_METHOD=memory

# Default output directory name template (relative or absolute)
# DEFAULT_OUTPUT_DIR=./output

# Optional: Set UI logging or debugging level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
